# Copy to .env and fill in. .env is gitignored.

# Deployer key. Use a throwaway key, then transfer contract ownership to the
# wallet that should own the collection (see README).
PRIVATE_KEY=

# Optional RPC overrides (defaults are the public BSC endpoints).
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Optional: contract verification on BscScan.
BSCSCAN_API_KEY=

# Challenge difficulty in bits (8..32). Default 16.
# 16 ~ 65k hashes (~2-5s desktop) · 18 ~ 262k (~10s) · 20 ~ 1.05M (~40s)
DIFFICULTY_BITS=16
