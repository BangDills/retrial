{
  "name": "retrial",
  "version": "1.0.0",
  "private": true,
  "description": "Challenge-gated NFT mint (PoW) + escrow marketplace on BNB Smart Chain",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:testnet": "hardhat run scripts/deploy.js --network bscTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network bsc",
    "mint:agent": "node scripts/mint-agent.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.29.1"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "dotenv": "^17.0.0",
    "@noble/hashes": "^1.3.2"
  }
}
